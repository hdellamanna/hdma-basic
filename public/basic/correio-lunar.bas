10 REM CORREIO LUNAR - FLIPERAMA 2000
20 DIM D(35)
30 M$="R..#...#.S.M...#..#.M#..S...#....S.M"
40 P=0:E=8:N=0
50 PRINT
60 PRINT "CORREIO LUNAR"
70 PRINT "DELIVER THE MAIL AT 3 STATIONS (M)."
80 PRINT "SOLAR PANELS (S) RECHARGE. CRATERS (#) BLOCK."
90 PRINT "USE 1 UP, 2 LEFT, 3 DOWN, 4 RIGHT. 0 QUITS."
100 PRINT
110 FOR I=0 TO 35
120 A$=MID$(M$,I+1,1)
130 IF D(I)=1 THEN A$="+"
140 IF I=P THEN A$="R"
150 IF I<>P AND MID$(M$,I+1,1)="R" THEN A$="."
160 PRINT A$;" ";
170 IF INT((I+1)/6)*6=I+1 THEN PRINT
180 NEXT I
190 PRINT "ENERGY";E;"  DELIVERIES";N;"OF 3"
200 IF N=3 THEN GOTO 500
210 IF E=0 THEN GOTO 520
220 INPUT "MOVE";C
230 IF C=0 THEN END
240 X=P-6*INT(P/6):Y=INT(P/6)
250 IF C=1 THEN Y=Y-1
260 IF C=2 THEN X=X-1
270 IF C=3 THEN Y=Y+1
280 IF C=4 THEN X=X+1
290 Q=Y*6+X
300 IF Q=P THEN GOTO 460
310 IF X<0 OR X>5 OR Y<0 OR Y>5 THEN GOTO 460
320 A$=MID$(M$,Q+1,1)
330 IF A$="#" THEN GOTO 460
340 P=Q:E=E-1
350 IF A$="S" THEN E=8
360 IF A$<>"M" THEN GOTO 100
370 IF D(P)=1 THEN GOTO 100
380 D(P)=1:N=N+1
390 GOTO 100
460 PRINT "BLOCKED."
470 GOTO 220
500 PRINT "ALL THREE DELIVERIES ARRIVED."
510 END
520 PRINT "BATTERY DEPLETED."
530 END
